/* ---------- Next batches, option E: a route to 2027 (user 2026-11-09: "Admissions open 2027 should be redesigned") ----------
   A dashed route line with one stop per start date, "+N days" between stops, and the batches hanging under each stop (same-day batches stack).
   Site vocabulary only: cream paper, 24px ring cards, saffron flagship, rust line, pill tag, square button. Option D (countdown) and A to C are in
   apps/my-app/backup/removed-sections/RecipeBatches.option*.bak; the .rs-cd-*, .rs-cal-*, .rs-tt-* and .rs-bt-* rules stay above, unused. */
.rs-rt-line { list-style: none; margin: 60px 0 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); gap: 0 32px; position: relative; }
.rs-rt-line::before { content: ""; position: absolute; left: 12px; right: 0; top: 12px; border-top: 2px dashed rgba(141, 46, 19, 0.55); }
.rs-rt-pin { position: relative; display: flex; align-items: flex-start; gap: 14px; margin-bottom: 26px; }
.rs-rt-dot { position: relative; z-index: 1; flex: none; width: 26px; height: 26px; border-radius: 50%; background: var(--rs-cream); border: 5px solid var(--rs-rust); box-shadow: 0 0 0 5px var(--rs-cream); }
.rs-rt-when b { display: block; font-family: var(--rs-body), sans-serif; font-weight: 800; letter-spacing: -0.04em; line-height: 1; font-size: clamp(30px, 3.2vw, 52px); color: var(--rs-deep); font-variant-numeric: lining-nums; }
.rs-rt-when small { display: block; margin-top: 6px; font-family: var(--rs-display), sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rs-rust); }
.rs-rt-gap { position: absolute; z-index: 2; left: -16px; top: 0; transform: translateX(-50%); padding: 3px 10px; border-radius: 999px; background: var(--rs-saffron); color: var(--rs-deep); font-family: var(--rs-display), sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 0.06em; white-space: nowrap; }
.rs-rt-cards { display: grid; gap: 18px; align-content: start; }
.rs-rt-card { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 24px; border-radius: 24px; background: #fff7e4; color: var(--rs-deep); box-shadow: 0 0 0 1.5px rgba(141, 46, 19, 0.18), 0 10px 26px rgba(70, 30, 12, 0.08); }
.rs-rt-card.is-flagship { background: var(--rs-saffron); }
.rs-rt-card.is-flagship .rs-tag { background: var(--rs-deep); color: var(--rs-saffron); }
.rs-rt-card h3 { margin: 0; font-family: var(--rs-body), sans-serif; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; font-size: clamp(22px, 1.9vw, 28px); }
.rs-rt-card > p:not(.rs-rt-meta) { margin: 0; font-size: 15.5px; line-height: 1.5; opacity: 0.88; }
.rs-rt-card .flex { width: 100%; }
.rs-rt-meta { margin: 0; font-family: var(--rs-display), sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--rs-rust); }
.rs-rt-card.is-flagship .rs-rt-meta { color: var(--rs-deep); }
.rs-rt-card.is-flagship .rs-bt-fast { background: rgba(45, 18, 9, 0.15); color: var(--rs-deep); }
.rs-rt-card.is-flagship .rs-rt-reg .rs-btn-label, .rs-rt-card.is-flagship .rs-rt-reg .rs-btn-arrow { background: var(--rs-deep); color: var(--rs-cream); }
@media (max-width: 900px) {
  .rs-rt-line { grid-template-columns: 1fr; gap: 40px; }
  .rs-rt-line::before { left: 12px; right: auto; top: 12px; bottom: 12px; border-top: 0; border-left: 2px dashed rgba(141, 46, 19, 0.55); }
  .rs-rt-stop { position: relative; padding-left: 52px; }
  .rs-rt-dot { position: absolute; left: 0; top: 0; }
  .rs-rt-gap { position: static; transform: none; align-self: flex-start; margin-top: 4px; }
  .rs-rt-pin { flex-wrap: wrap; align-items: center; }
}
